<jsp:root xmlns:c="http://java.sun.com/jsp/jstl/core"
          xmlns:jsp="http://java.sun.com/JSP/Page"
          xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
          xmlns:fn="http://java.sun.com/jsp/jstl/functions"
          xmlns:admin="admin"
          version="2.0">
    <jsp:useBean id="webManager" class="org.jivesoftware.util.WebManager" />

    <jsp:directive.attribute name="connectionType" required="true" type="org.jivesoftware.openfire.spi.ConnectionType"/>
    <!-- The location to show in the File box instead of the current one, such as the one submitted in a save that failed. -->
    <jsp:directive.attribute name="location" required="false" type="java.lang.String"/>

    <c:set var="displayedLocation" value="${empty location ? webManager.XMPPServer.certificateStoreManager.getTrustStoreConfiguration(connectionType).file : location}"/>

    <!-- Store passwords are never sent to the browser: see storePasswordConfig.tagx. -->
    <c:choose>
        <c:when test="${connectionType eq 'SOCKET_C2S' or connectionType.fallback eq 'SOCKET_C2S'}">

            <h4><fmt:message key="ssl.certificates.trust-store.c2s"/></h4>

            <c:if test="${empty webManager.XMPPServer.certificateStoreManager.getTrustStore(connectionType)}">
                <admin:infobox type="warning"><fmt:message key="ssl.certificates.store-management.error.cannot-access"/></admin:infobox>
            </c:if>

            <table>
                <tbody>
                <tr>
                    <td><label for="loc-trust-c2s"><fmt:message key="ssl.certificates.store-management.file_label"/>:</label></td>
                    <td><input id="loc-trust-c2s" name="loc-trust-c2s" type="text" size="80" value="${fn:escapeXml(displayedLocation)}"/></td>
                </tr>
                <admin:storePasswordConfig fieldName="pwd-trust-c2s" fieldId="pwd-trust-c2s-${connectionType}" passwordSet="${admin:isStorePasswordSet(webManager.XMPPServer.certificateStoreManager.getTrustStoreConfiguration(connectionType).password)}"/>
                <tr>
                    <td>&#160;</td>
                    <td><a href="security-truststore.jsp?connectionType=${fn:escapeXml(connectionType)}"><fmt:message key="ssl.certificates.store-management.manage"/></a></td>
                </tr>
                </tbody>
            </table>
        </c:when>

        <c:otherwise>
            <h4><fmt:message key="ssl.certificates.trust-store.s2s"/></h4>

            <c:if test="${empty webManager.XMPPServer.certificateStoreManager.getTrustStore(connectionType)}">
                <admin:infobox type="warning"><fmt:message key="ssl.certificates.store-management.error.cannot-access"/></admin:infobox>
            </c:if>

            <table>
                <tbody>
                <tr>
                    <td><label for="loc-trust-s2s"><fmt:message key="ssl.certificates.store-management.file_label"/>:</label></td>
                    <td><input id="loc-trust-s2s" name="loc-trust-s2s" type="text" size="80" value="${fn:escapeXml(displayedLocation)}"/></td>
                </tr>
                <admin:storePasswordConfig fieldName="pwd-trust-s2s" fieldId="pwd-trust-s2s-${connectionType}" passwordSet="${admin:isStorePasswordSet(webManager.XMPPServer.certificateStoreManager.getTrustStoreConfiguration(connectionType).password)}"/>
                <tr>
                    <td>&#160;</td>
                    <td><a href="security-truststore.jsp?connectionType=${fn:escapeXml(connectionType)}"><fmt:message key="ssl.certificates.store-management.manage"/></a></td>
                </tr>
                </tbody>
            </table>
        </c:otherwise>

    </c:choose>
</jsp:root>
