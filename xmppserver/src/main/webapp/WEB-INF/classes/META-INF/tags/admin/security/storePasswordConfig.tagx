<!--
  ~ Renders the password row of a certificate store form. The store's password is never sent to the browser: the row
  ~ shows whether the store has a password, "(set)" or "(none)", and a "Change" (or "Set") link that reveals an empty
  ~ field. The field starts hidden and disabled, so it is not submitted unless revealed. The value is the password
  ~ Openfire uses to open the store file; saving it does not re-encrypt the file, which the hint under the open field
  ~ says. js/security-certificate-store-management.js handles the links and marks the row once a password is typed.
  -->
<jsp:root xmlns:c="http://java.sun.com/jsp/jstl/core"
          xmlns:jsp="http://java.sun.com/JSP/Page"
          xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
          xmlns:fn="http://java.sun.com/jsp/jstl/functions"
          version="2.0">

    <jsp:directive.attribute name="fieldName" required="true" type="java.lang.String"/>
    <jsp:directive.attribute name="fieldId" required="true" type="java.lang.String"/>
    <jsp:directive.attribute name="passwordSet" required="true" type="java.lang.Boolean"/>

    <c:set var="id" value="${fn:escapeXml(fieldId)}"/>
    <fmt:message key="ssl.certificates.store-management.password_placeholder" var="placeholder"/>

    <tr class="store-password-row">
        <td class="store-password-label"><label id="${id}-label" for="${id}"><fmt:message key="ssl.certificates.store-management.password_label"/>:</label></td>
        <td class="store-password">
            <span class="store-password-status">
                <span id="${id}-state" class="store-password-state">
                    <c:choose>
                        <c:when test="${passwordSet}"><fmt:message key="ssl.certificates.store-management.password_state_set"/></c:when>
                        <c:otherwise><fmt:message key="ssl.certificates.store-management.password_state_none"/></c:otherwise>
                    </c:choose>
                </span>
                <jsp:text>&#160;&#160;</jsp:text>
                <a href="#" id="${id}-change" role="button" class="store-password-change" aria-expanded="false" aria-controls="${id}-edit" aria-labelledby="${id}-label ${id}-state ${id}-change">
                    <c:choose>
                        <c:when test="${passwordSet}"><fmt:message key="ssl.certificates.store-management.password_change"/></c:when>
                        <c:otherwise><fmt:message key="ssl.certificates.store-management.password_set"/></c:otherwise>
                    </c:choose>
                </a>
            </span>
            <div id="${id}-edit" class="store-password-edit" hidden="hidden">
                <input id="${id}" name="${fn:escapeXml(fieldName)}" type="password" size="30" value="" placeholder="${fn:escapeXml(placeholder)}" autocomplete="new-password" disabled="disabled" aria-describedby="${id}-hint"/>
                <jsp:text>&#160;&#160;</jsp:text>
                <a href="#" role="button" class="store-password-cancel"><fmt:message key="global.cancel"/></a>
                <span id="${id}-hint" class="store-password-hint">
                    <fmt:message key="ssl.certificates.store-management.password_hint"/>
                    <jsp:text> </jsp:text>
                    <fmt:message key="ssl.certificates.store-management.password_apply">
                        <fmt:param><fmt:message key="global.save_settings"/></fmt:param>
                    </fmt:message>
                </span>
            </div>
        </td>
    </tr>
</jsp:root>
