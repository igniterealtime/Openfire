<jsp:root xmlns:c="http://java.sun.com/jsp/jstl/core"
          xmlns:jsp="http://java.sun.com/JSP/Page"
          xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
          xmlns:fn="http://java.sun.com/jsp/jstl/functions"
          xmlns:admin="admin"
          version="2.0">
    <jsp:useBean id="webManager" class="org.jivesoftware.util.WebManager" />

    <jsp:directive.attribute name="connectionType" required="true" type="org.jivesoftware.openfire.spi.ConnectionType"/>
    <!-- The location to show in the File box instead of the current one, such as the one submitted in a save that failed. -->
    <jsp:directive.attribute name="location" required="false" type="java.lang.String"/>

    <c:set var="displayedLocation" value="${empty location ? webManager.XMPPServer.certificateStoreManager.getIdentityStoreConfiguration(connectionType).file : location}"/>

    <h4><fmt:message key="ssl.certificates.identity-store"/></h4>

    <c:if test="${empty webManager.XMPPServer.certificateStoreManager.getIdentityStore(connectionType)}">
        <admin:infobox type="warning"><fmt:message key="ssl.certificates.store-management.error.cannot-access"/></admin:infobox>
    </c:if>

    <!-- The store password is never sent to the browser: see storePasswordConfig.tagx. -->
    <table>
        <tbody>
        <tr>
            <td><label for="loc-key"><fmt:message key="ssl.certificates.store-management.file_label"/>:</label></td>
            <td><input id="loc-key" name="loc-key" type="text" size="80" value="${fn:escapeXml(displayedLocation)}"/></td>
        </tr>
        <admin:storePasswordConfig fieldName="pwd-key" fieldId="pwd-key-${connectionType}" passwordSet="${admin:isStorePasswordSet(webManager.XMPPServer.certificateStoreManager.getIdentityStoreConfiguration(connectionType).password)}"/>
        <tr>
            <td>&#160;</td>
            <td><a href="security-keystore.jsp?connectionType=${fn:escapeXml(connectionType)}"><fmt:message key="ssl.certificates.store-management.manage"/></a></td>
        </tr>
        </tbody>
    </table>
</jsp:root>
