<!--
  ~ Renders the password row of a certificate store form. The store's password is never sent to the browser: the row
  ~ shows an "Update password" link (or "Set password" when the store has none) that reveals an empty field. The field
  ~ starts hidden and disabled, so it is not submitted unless revealed. The value is the password Openfire uses to open
  ~ the store file; saving it does not re-encrypt the file, which the hint beside the field says. The page script in
  ~ security-certificate-store-management.jsp handles the "Update password" and "Cancel" links.
  -->
<jsp:root xmlns:c="http://java.sun.com/jsp/jstl/core"
          xmlns:jsp="http://java.sun.com/JSP/Page"
          xmlns:fmt="http://java.sun.com/jsp/jstl/fmt"
          xmlns:fn="http://java.sun.com/jsp/jstl/functions"
          version="2.0">

    <jsp:directive.attribute name="fieldName" required="true" type="java.lang.String"/>
    <jsp:directive.attribute name="fieldId" required="true" type="java.lang.String"/>
    <jsp:directive.attribute name="passwordSet" required="true" type="java.lang.Boolean"/>

    <tr>
        <td class="store-password-label"><label for="${fn:escapeXml(fieldId)}"><fmt:message key="ssl.certificates.store-management.password_label"/>:</label></td>
        <td class="store-password">
            <span class="store-password-status">
                <a href="#" role="button" class="store-password-change">
                    <c:choose>
                        <c:when test="${passwordSet}"><fmt:message key="ssl.certificates.store-management.password_change"/></c:when>
                        <c:otherwise><fmt:message key="ssl.certificates.store-management.password_set"/></c:otherwise>
                    </c:choose>
                </a>
            </span>
            <span class="store-password-edit" hidden="hidden">
                <input id="${fn:escapeXml(fieldId)}" name="${fn:escapeXml(fieldName)}" type="password" size="30" value="" autocomplete="new-password" disabled="disabled" aria-describedby="${fn:escapeXml(fieldId)}-hint"/>
                <jsp:text>&#160;&#160;</jsp:text>
                <a href="#" role="button" class="store-password-cancel"><fmt:message key="global.cancel"/></a>
                <span id="${fn:escapeXml(fieldId)}-hint" class="store-password-hint"><fmt:message key="ssl.certificates.store-management.password_hint"/></span>
            </span>
        </td>
    </tr>
</jsp:root>
